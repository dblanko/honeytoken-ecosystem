# Copy this to .env and fill in real values. Don't commit .env.
# No spaces around "=", no quotes, no comments on the same line as a value.

# --- Required: Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Decoy login (optional) ---
# Leave both lines commented out if the decoy was made by honeytoken_cli.py: its names
# (svc_ + 6 letters, prod_ + 5 letters) are recognised automatically.
# Uncomment and fill them in only if the decoy was NOT made by the CLI or uses other names:
# copy the user and database from the DSN (decoys/tokens_vault.json).
# Use random names, never postgres, admin, test, root, user: bots try those.
# A match on EITHER one raises the alert. Several values: comma-separated.
# DECOY_USERS=
# DECOY_DATABASES=

# --- Optional (defaults shown) ---
# Alert on valid Postgres logins that are NOT the decoy (bots): 1 = yes
# ALERT_ON_UNMATCHED=0
# Alert on SSL probes without any login (scanners): 1 = yes
# ALERT_ON_SSL_PROBE=0
# Look up country/provider of the alerting IP on ip-api.com (plain HTTP,
# the IP goes to a third party): 0 = off
# GEO_LOOKUP=1
# Send one "listener started" message to Telegram on every start: 0 = off
# STARTUP_NOTICE=1
# Seconds without a heartbeat before the watchdog restarts the process
# WATCHDOG_TIMEOUT=60
# MAX_CONNECTIONS=200
# MAX_CONN_PER_IP=20
# MAX_ALERTS_PER_MINUTE=20

# LISTEN_PORT is intentionally not here: docker-compose.yml maps 5432:5432.
# If you change the port, change it in the "ports:" line of compose too.
